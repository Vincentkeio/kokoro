# 构建产物（交叉编译出来的二进制有 14MB+，不进仓库）
/dist/
*.exe
*.exe~
/pid

# 本地临时工作区（截图、日志、探测脚本产物）
/work/

# 运行时数据（数据库、上传的头像、证书）
/data/
*.db
*.db-shm
*.db-wal

# 证书与私钥（绝不入库）
*.pem
*.key
*.crt
cert/

# 本机凭据与配置
.env
*.local
config.toml

# AI 助手的工作记忆，属于本机，不是项目内容
.workbuddy-ai/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本机凭据（update-agents.sh 会 source；严禁入库）
scripts/agents.local.sh

# 维护者专用部署资料（含服务器地址、SSH 配置或线上节点信息）
scripts/deploy.ps1
scripts/update-agents.sh
scripts/push-all.sh
docs/DEPLOYMENT-*.md
docs/PROPOSAL-v*.md
docs/HANDOFF.md
