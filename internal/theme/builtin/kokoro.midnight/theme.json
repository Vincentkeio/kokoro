  "layoutSchemaVersion": 1,
  "layout": {
    "shell": {
      "contentMaxWidth": "2080px",
      "contentAlign": "center",
      "header": {
        "variant": "solid",
        "sticky": true,
        "showSearch": false,
        "showModeSwitch": false
      },
      "footer": {
        "variant": "minimal"
      }
    },
    "home": {
      "hero": {
        "enabled": false,
        "variant": "plain"
      },
      "list": {
        "mode": "card",
        "allowUserSwitch": false,
        "groupBy": "group",
        "card": {
          "minWidth": "300px",
          "gap": "18px",
          "border": true,
          "shadow": "sm",
          "hoverLift": true,
          "columns": 3
        },
        "table": {
          "density": "comfortable",
          "striped": false,
          "rowHover": true
        },
        "compact": {
          "rowHeight": "52px",
          "dividers": true,
          "showFlag": true,
          "inlineBars": true
        }
      }
    },
    "detail": {
      "header": {
        "variant": "compact",
        "height": "300px",
        "showTags": true,
        "secondaryLine": "location"
      },
      "sectionGap": "28px",
      "introFontSize": "14px"
    },
    "charts": {
      "type": "line",
      "grid": true,
      "legend": true,
      "axisLabel": true,
      "smooth": true,
      "tooltip": "axis",
      "height": "220px",
      "heightDetail": "300px"
    },
    "misc": {
      "statusDotStyle": "solid",
      "usageBarStyle": "segmented",
      "tagStyle": "square",
      "badgeStyle": "outline",
      "showUptime": true,
      "numberFormat": "si",
      "dateFormat": "relative",
      "uptimeBarStyle": "tiles"
    },
    "globe": {
      "showRoutes": true,
      "showFlow": true,
      "autoRotate": true
    }
  }
}
