{
  "schemaVersion": 1,
  "id": "kokoro.simple",
  "name": "简洁",
  "version": "1.4.0",
  "description": "以雾灰底色、石墨文字与冷调蓝色强调构成的清爽运维界面。",
  "author": "Kokoro",
  "license": "MIT",
  "tags": [
    "light",
    "minimal",
    "operations"
  ],
  "tokensSchemaVersion": 2,
  "mode": {
    "allowUserSwitch": true,
    "supportsDark": true,
    "default": "light"
  },
