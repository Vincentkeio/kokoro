{
  "schemaVersion": 1,
  "id": "kokoro.simple",
  "name": "简洁",
  "version": "1.3.1",
  "description": "清爽克制的浅色运维界面，以石墨文字、雾白底色和清晰的状态色呈现关键信息。",
  "author": "Kokoro",
  "license": "MIT",
  "tags": [
    "light",
    "minimal",
    "operations"
  ],
  "tokensSchemaVersion": 2,
  "mode": {
    "allowUserSwitch": true,
    "supportsDark": true,
    "default": "light"
  },
