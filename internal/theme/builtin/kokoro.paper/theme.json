  "layoutSchemaVersion": 1,
  "layout": {
    "shell": {
      "contentMaxWidth": "2080px",
      "contentAlign": "center",
      "header": {
        "variant": "bordered",
        "sticky": true,
        "showSearch": false,
        "showModeSwitch": false
      },
      "footer": {
        "variant": "minimal"
      }
    },
    "home": {
      "hero": {
        "enabled": false,
        "variant": "plain"
      },
      "list": {
        "mode": "card",
        "allowUserSwitch": false,
        "groupBy": "group",
        "card": {
          "minWidth": "340px",
          "gap": "20px",
          "border": true,
          "shadow": "sm",
          "hoverLift": true,
          "columns": 3
        },
        "table": {
          "density": "comfortable",
          "striped": false,
          "rowHover": true
        },
        "compact": {
          "rowHeight": "48px",
          "dividers": true,
          "showFlag": true,
          "inlineBars": true
        }
      }
    },
    "detail": {
      "header": {
        "variant": "hero",
        "height": "360px",
        "showTags": true,
        "secondaryLine": "location"
      },
      "sectionGap": "28px",
      "introFontSize": "14px"
    },
    "charts": {
      "type": "bar",
      "grid": true,
      "legend": true,
      "axisLabel": true,
      "smooth": false,
      "tooltip": "axis",
      "height": "200px",
      "heightDetail": "300px"
    },
    "misc": {
      "statusDotStyle": "solid",
      "usageBarStyle": "segmented",
      "tagStyle": "text",
      "badgeStyle": "outline",
      "showUptime": true,
      "numberFormat": "si",
      "dateFormat": "relative",
      "uptimeBarStyle": "ruled"
    },
    "globe": {
      "showRoutes": true,
      "showFlow": true,
      "autoRotate": false
    }
  }
}
