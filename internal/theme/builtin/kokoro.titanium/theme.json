    "--kokoro-globe-matrix-highlight": "#a4e8ff",
    "--kokoro-globe-matrix-secondary": "#c5bfff",
    "--kokoro-globe-matrix-speed": "1",
    "--kokoro-globe-matrix-density": "24",
    "--kokoro-globe-matrix-opacity": "1",
    "--kokoro-usage-bar-glow": "0 0 5px currentColor, 0 0 13px currentColor"
  },
  "layoutSchemaVersion": 2,
  "layout": {
    "shell": {
      "contentMaxWidth": "2080px",
      "contentAlign": "center",
      "header": {
        "variant": "bordered",
        "sticky": true,
        "showSearch": false,
        "showModeSwitch": false
      },
      "footer": {
        "variant": "minimal"
      }
    },
    "home": {
      "hero": {
        "enabled": false,
        "variant": "plain"
      },
      "list": {
        "mode": "card",
        "allowUserSwitch": false,
        "groupBy": "group",
        "card": {
          "minWidth": "300px",
          "gap": "18px",
          "border": true,
          "shadow": "glow",
          "hoverLift": true,
          "columns": 3
        }
      }
    },
    "detail": {
      "header": {
        "variant": "compact",
        "showTags": true,
        "secondaryLine": "location"
      },
      "sectionGap": "28px",
      "introFontSize": "14px"
    },
    "charts": {
      "type": "line",
      "grid": true,
      "legend": true,
      "axisLabel": true,
      "smooth": true,
      "tooltip": "axis",
      "height": "220px",
      "heightDetail": "300px"
    },
    "misc": {
      "statusDotStyle": "glow",
      "usageBarStyle": "laser",
      "uptimeBarStyle": "tiles",
      "tagStyle": "square",
      "badgeStyle": "outline",
      "showUptime": true,
      "numberFormat": "si",
      "dateFormat": "relative"
    },
    "globe": {
      "showRoutes": true,
      "showFlow": true,
      "autoRotate": true,
      "backdrop": "matrix"
    },
    "visuals": {
      "globe-background": {
        "border-color": "rgba(94,188,225,.18)",
        "box-shadow": "inset 0 0 38px #030810"
      },
      "usage-fill": {
        "box-shadow": "0 0 5px currentColor, 0 0 13px currentColor"
      }
    },
    "motions": {
      "laser-scan": {
        "duration": "7s",
        "easing": "ease-in-out",
        "direction": "alternate",
        "frames": [
          {
            "at": 0,
            "style": {
              "background-position": "0% 50%",
              "opacity": "0.2"
            }
          },
          {
            "at": 100,
            "style": {
              "background-position": "100% 50%",
              "opacity": "0.6"
            }
          }
        ]
      }
    },
    "layers": {
      "usage-fill": [
        {
          "style": {
            "background": "linear-gradient(90deg, transparent 30%, rgba(255,255,255,.7) 50%, transparent 70%)",
            "background-size": "220% 100%",
            "motion": "custom:laser-scan"
          },
          "hideOnMobile": true,
          "hideOnReducedMotion": true
        }
      ]
    },
    "responsive": {
      "mobile": {
        "usage-fill": {
          "box-shadow": "0 0 5px currentColor, 0 0 13px currentColor"
        }
      }
    }
  }
}
