    "--kokoro-globe-rotation-speed": "0.8",
    "--kokoro-content-max-width": "2080px",
    "--kokoro-bg-size": "max(100vw, 160vh)",
    "--kokoro-hero-gradient": "radial-gradient(ellipse at center,rgba(25,115,157,.23),#060f1a 75%)",
