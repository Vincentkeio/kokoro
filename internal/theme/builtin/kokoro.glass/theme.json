  "name": "毛玻璃",
  "version": "1.0.0",
  "description": "半透明表面 + 背景模糊的亚克力质感。这份同时是一份边界样例：每个能配的项都取了与默认不同的值（表格列表、按机房分组、Hero 渐变头、柱状图、ring 状态点、segmented 占用条），用来验证主题系统能改到什么程度。",
  "author": "Kokoro",
  "license": "MIT",
  "tags": ["light", "glass", "blur", "max", "demo"],
  "tokensSchemaVersion": 2,
  "mode": {
    "default": "light",
    "allowUserSwitch": true,
    "supportsDark": true
