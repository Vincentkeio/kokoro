  "layoutSchemaVersion": 1,
  "layout": {
    "shell": {
      "contentMaxWidth": "1600px",
      "contentAlign": "left",
      "header": { "variant": "blur", "sticky": false, "showSearch": true, "showModeSwitch": true },
      "footer": { "variant": "columns" }
    },
    "home": {
      "hero": {
        "enabled": true,
        "variant": "gradient",
        "align": "center",
        "subtitle": "半透明面板叠在渐变底色上 —— 这台面板是「主题能力上限」的样例",
        "showStats": true
      },
      "list": {
        "mode": "table",
        "allowUserSwitch": true,
        "groupBy": "provider",
        "card": { "minWidth": "360px", "gap": "var(--kokoro-space-6)", "border": false, "shadow": "lg", "hoverLift": false },
        "table": { "density": "compact", "striped": true, "rowHover": true, "showUnit": false },
        "compact": { "rowHeight": "52px", "dividers": false, "showFlag": false, "inlineBars": true }
      }
    },
    "detail": {
      "header": { "variant": "hero", "height": "460px", "showTags": true, "secondaryLine": "specs" },
      "sectionGap": "clamp(20px, 4vw, 56px)",
      "introFontSize": "15px",
      "commentsCollapsed": true
    },
    "charts": {
      "type": "bar",
      "grid": false,
      "legend": false,
      "axisLabel": true,
      "smooth": false,
      "tooltip": "item",
      "height": "240px",
      "heightDetail": "380px"
    },
    "misc": {
      "statusDotStyle": "ring",
      "usageBarStyle": "segmented",
      "tagStyle": "square",
      "badgeStyle": "solid",
      "showUptime": false,
      "numberFormat": "plain",
      "dateFormat": "absolute"
    }
  }
