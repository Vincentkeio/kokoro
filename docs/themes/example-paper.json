  "layoutSchemaVersion": 1,
  "layout": {
    "shell": {
      "contentMaxWidth": "1120px",
      "contentAlign": "left",
      "header": {
        "variant": "blur",
        "sticky": true,
        "showSearch": true,
        "showModeSwitch": false
      },
      "footer": {
        "variant": "columns"
      }
    },
    "home": {
      "hero": {
        "enabled": true,
        "variant": "plain",
        "align": "left",
        "showStats": true
      },
      "list": {
        "mode": "card",
        "groupBy": "none",
        "card": {
          "minWidth": "340px",
          "gap": "24px",
          "border": true,
          "shadow": "sm",
          "hoverLift": false
        }
      }
    },
    "detail": {
      "header": {
        "variant": "hero",
        "height": "360px",
        "showTags": true,
        "secondaryLine": "location"
      },
      "sectionGap": "40px",
      "introFontSize": "17px",
      "commentsCollapsed": false
    },
    "charts": {
      "type": "area",
      "grid": true,
      "legend": true,
      "axisLabel": true,
      "smooth": true,
      "tooltip": "axis",
      "height": "220px",
      "heightDetail": "320px"
    },
    "misc": {
      "statusDotStyle": "ring",
      "usageBarStyle": "segmented",
      "tagStyle": "pill",
      "badgeStyle": "soft",
      "showUptime": true,
      "numberFormat": "si",
      "dateFormat": "absolute"
    }
