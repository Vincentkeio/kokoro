            },
            "numberFormat": {
              "description": "数值格式化：si 带单位（1.2 GB）、plain 纯数字（1,234）、percent 百分比。不填按内置默认。",
              "enum": [
                "si",
                "plain",
                "percent"
              ],
              "$comment": "layout.go enums['misc.numberFormat']"
            },
            "dateFormat": {
              "description": "日期显示为相对时间（3 小时前）还是绝对时间。不填按内置默认。",
              "enum": [
