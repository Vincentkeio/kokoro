                  "pattern": "^\\s*(?:0|auto|none|inherit|initial|(?:calc|min|max|clamp|var)\\([^;{}<>\\\\@]*\\)|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|%|vh|vw|vmin|vmax|ch|ex|pt|cm|mm|in))\\s*$"
                },
                "showTags": {
                  "description": "头部是否显示标签。不填按内置默认（显示）。",
                  "type": "boolean"
                },
                "secondaryLine": {
                  "description": "头部第二行显示什么：location 地区、specs 配置、uptime 在线时长、none 不显示。不填按内置默认。",
                  "enum": [
                    "location",
                    "specs",
                    "uptime",
                    "none"
                  ],
                  "$comment": "layout.go enums['detail.header.secondaryLine']"
                }
              }
            },
            "sectionGap": {
              "description": "各区块之间的垂直间距。不填按 var(--kokoro-space-6)（32px）处理。",
              "type": "string",
              "maxLength": 200,
              "pattern": "^\\s*(?:0|auto|none|inherit|initial|(?:calc|min|max|clamp|var)\\([^;{}<>\\\\@]*\\)|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|%|vh|vw|vmin|vmax|ch|ex|pt|cm|mm|in))\\s*$"
            },
            "introFontSize": {
              "description": "简介正文字号。不填则沿用 --kokoro-font-size-md。",
              "type": "string",
              "maxLength": 200,
              "pattern": "^\\s*(?:0|auto|none|inherit|initial|(?:calc|min|max|clamp|var)\\([^;{}<>\\\\@]*\\)|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|%|vh|vw|vmin|vmax|ch|ex|pt|cm|mm|in))\\s*$"
            },
            "commentsCollapsed": {
