    "package": {
      "type": "object",
      "description": "包完整性信息。仅在使用 .kokoro-theme 主题包时由 Hub 自动写入；如果你只是手写一份 theme.json 导入，整块不要填。",
      "additionalProperties": false,
      "properties": {
        "format": {
          "description": "包格式标识。留空或填 kokoro-theme 均可，填其它值 Hub 会拒绝。",
          "enum": [
            "kokoro-theme"
          ]
        },
        "files": {
          "description": "包内文件相对路径清单。导入裸 theme.json 时不要填。",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "sha256": {
          "description": "包内容汇总哈希（小写十六进制）。Hub 会拿它与实际算出的值核对，不一致则拒绝导入。",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signed": {
          "description": "是否附带签名。当前 Hub 只记录这个声明、不做校验，因此填 true 不代表包真的可信。",
          "type": "boolean"
        },
        "bundle": {
          "description": "预留字段：签名者 ID。当前版本不使用。",
          "type": "string",
          "maxLength": 64
        }
      }
    }
  },
