          }
        },
        "charts": {
          "type": "object",
          "description": "图表通用参数，作用于首页与详情页的所有图表。",
          "additionalProperties": false,
          "properties": {
            "type": {
              "description": "图表类型。不填按 area（面积图）处理。",
              "enum": [
                "line",
                "area",
                "bar"
              ],
              "$comment": "layout.go enums['charts.type']"
            },
            "grid": {
              "description": "是否绘制网格线。不填按内置默认（绘制）；写 false 会输出 data-k-chart-grid=\"0\" 让前端SVG 跳过网格。",
              "type": "boolean"
