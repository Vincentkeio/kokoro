            },
            "height": {
              "description": "常规图表高度。不填按 200px 处理。",
              "type": "string",
              "maxLength": 200,
              "pattern": "^\\s*(?:0|auto|none|inherit|initial|(?:calc|min|max|clamp|var)\\([^;{}<>\\\\@]*\\)|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|%|vh|vw|vmin|vmax|ch|ex|pt|cm|mm|in))\\s*$"
            },
            "heightDetail": {
              "description": "详情页图表高度（通常比首页高）。不填按 300px 处理。",
              "type": "string",
              "maxLength": 200,
              "pattern": "^\\s*(?:0|auto|none|inherit|initial|(?:calc|min|max|clamp|var)\\([^;{}<>\\\\@]*\\)|[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:px|em|rem|%|vh|vw|vmin|vmax|ch|ex|pt|cm|mm|in))\\s*$"
